[Desktop Entry]
Version=1.0
Type=Application
Name=ATOM Chat
Comment=Start this ATOM Chat checkout (Talk voice prompt included)
Exec=bash -c 'f="$1"; f="${f#file://}"; cd "$(dirname "$f")" && exec ./scripts/start-atom.sh' atom-desktop %k
Terminal=true
Icon=utilities-terminal
Categories=Development;
StartupNotify=true
